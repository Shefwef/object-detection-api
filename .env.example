# ─────────────────────────────────────────────────────────────
# Environment configuration
# Copy to .env and override only what you need. Every value below
# is a documented default that ships in app/config.py.
# ─────────────────────────────────────────────────────────────

# ─── Application ───────────────────────────────────────────────
APP_NAME=CV Detection Platform
APP_VERSION=2.0.0
DEBUG=false

# ─── Server ────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
# Comma-separated origins ("*" = allow all).
# For the current live deployment set this to the Vercel origin so
# CORS locks the API to the deployed frontend:
#   CORS_ORIGINS=https://object-detection-api-psi.vercel.app
CORS_ORIGINS=*

# ─── Device (torch runtime) ────────────────────────────────────
# auto  - use CUDA when available, else CPU
# cuda  - force GPU (fails if not available)
# cpu   - force CPU
DEVICE=auto

# ─── YOLOv8 ────────────────────────────────────────────────────
YOLO_MODEL_NAME=yolov8n.pt
YOLO_CONFIDENCE=0.25
YOLO_IOU_THRESHOLD=0.45

# ─── Detectron2 ────────────────────────────────────────────────
DETECTRON2_CONFIG=COCO-InstanceSegmentation/mask_rcnn_R_50_FPN_3x.yaml
DETECTRON2_CONFIDENCE=0.5

# ─── Grounding DINO ────────────────────────────────────────────
GROUNDING_DINO_MODEL=IDEA-Research/grounding-dino-tiny
GROUNDING_DINO_BOX_THRESHOLD=0.35
GROUNDING_DINO_TEXT_THRESHOLD=0.25

# ─── SAM ───────────────────────────────────────────────────────
SAM_MODEL_TYPE=vit_b
SAM_CHECKPOINT=

# ─── Upload limits ─────────────────────────────────────────────
MAX_IMAGE_SIZE=10485760            # 10 MiB

# ─── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=false                     # true -> structlog JSON output

# ─── Inference cache ───────────────────────────────────────────
CACHE_ENABLED=true
INFERENCE_CACHE_TTL=3600           # seconds
INFERENCE_CACHE_MAX_ENTRIES=512    # in-memory LRU cap
# Optional: switch to Redis by setting a URL
# REDIS_URL=redis://localhost:6379/0

# ─── Metrics ───────────────────────────────────────────────────
METRICS_ENABLED=true
METRICS_WINDOW_SIZE=500            # in-memory ring buffer per model
# Optional: persist metrics in MongoDB
# MONGO_URL=mongodb://localhost:27017
# MONGO_DB_NAME=cv_detection
# MONGO_METRICS_COLLECTION=inference_metrics

# ─── Authentication ────────────────────────────────────────────
# Set AUTH_ENABLED=true to require X-API-Key header on protected routes.
# /health, /, /docs, /redoc, /openapi.json remain open.
AUTH_ENABLED=false
API_KEYS=demo-key-12345,another-key
RATE_LIMIT_PER_MINUTE=60
