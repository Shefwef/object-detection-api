# ──────────────── Environment Configuration ────────────────
# Copy this to .env and adjust values as needed
# All values below are defaults — override only what you need

# ─── App ───
DEBUG=false
LOG_LEVEL=INFO

# ─── Device ───
# "auto" = use GPU if available, else CPU
# "cuda" = force GPU (will fail without NVIDIA GPU + CUDA)
# "cpu"  = force CPU
DEVICE=auto

# ─── YOLO ───
YOLO_MODEL_NAME=yolov8n.pt
YOLO_CONFIDENCE=0.25
YOLO_IOU_THRESHOLD=0.45

# ─── Detectron2 ───
DETECTRON2_CONFIG=COCO-InstanceSegmentation/mask_rcnn_R_50_FPN_3x.yaml
DETECTRON2_CONFIDENCE=0.5

# ─── Grounding DINO ───
GROUNDING_DINO_MODEL=IDEA-Research/grounding-dino-tiny
GROUNDING_DINO_BOX_THRESHOLD=0.35
GROUNDING_DINO_TEXT_THRESHOLD=0.25

# ─── SAM ───
SAM_MODEL_TYPE=vit_b
SAM_CHECKPOINT=

# ─── Upload limits ───
MAX_IMAGE_SIZE=10485760
