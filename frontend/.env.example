# Frontend environment configuration.
# Copy to .env.local (dev) or set the same keys in Vercel → Settings →
# Environment Variables (prod).

# Absolute URL of the FastAPI backend.
# ─ Local dev: leave the default so Next.js rewrites /api/backend/*
#              to http://localhost:8000 via next.config.mjs.
# ─ Production: point at your public backend URL.
#     • ngrok tunnel:   https://<your-subdomain>.ngrok-free.dev
#     • Render service: https://<your-service>.onrender.com
#
# Current live backend (ngrok tunnel, rotates on tunnel restart):
#   https://unnecessarily-menispermaceous-rickey.ngrok-free.dev
NEXT_PUBLIC_API_BASE_URL=/api/backend

# Optional API key sent as X-API-Key. Only needed when the backend has
# AUTH_ENABLED=true.
NEXT_PUBLIC_API_KEY=

# Dev-only: where the /api/backend/* rewrite forwards to.
API_PROXY_TARGET=http://localhost:8000
