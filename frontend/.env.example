# Frontend environment configuration.
# Copy to .env.local and adjust as needed.

# Absolute URL of the FastAPI backend.  In production point this at your
# Hugging Face Space, e.g. https://shefwef-object-detection-studio.hf.space
# In local dev, leave the default so the Next.js rewrite proxies calls
# through /api/backend/* to http://localhost:8000.
NEXT_PUBLIC_API_BASE_URL=/api/backend

# Optional API key sent as X-API-Key. Only needed when the backend has
# AUTH_ENABLED=true.
NEXT_PUBLIC_API_KEY=

# Dev-only: where the /api/backend/* rewrite forwards to.
API_PROXY_TARGET=http://localhost:8000
